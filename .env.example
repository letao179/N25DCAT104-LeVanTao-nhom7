# ==========================================
# NextAuth.js / Auth.js Environment Variables
# ==========================================

# Secret used to encrypt and sign JWT tokens and cookies.
# Generate a secure key using: npx auth secret OR openssl rand -base64 32
AUTH_SECRET="your-generated-secret-key-here"
# NEXTAUTH_SECRET is supported as a fallback/alias
NEXTAUTH_SECRET="your-generated-secret-key-here"

# Canonical URL of your application (Required in production)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth Credentials
# Created via: GitHub -> Settings -> Developer Settings -> OAuth Apps
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"